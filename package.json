{
  "name": "check-deposit-recorder",
  "version": "1.3.6",
  "description": "Offline desktop app to record and reprint bank check/cash deposits (RCBC pickup slip).",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Poink1006/check-deposit-recorder.git"
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "electron:release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.victoria.checkdeposit",
    "productName": "Check Deposit Recorder",
    "files": [
      "**/*",
      "!reference/${/*}",
      "!**/*.md"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "Poink1006",
      "repo": "check-deposit-recorder",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.1"
  }
}
